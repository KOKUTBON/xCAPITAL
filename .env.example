# ==============================================================================
# xCAPITAL Environment Configuration Template (.env.example)
#
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# WARNING: Never commit .env or real credentials to source control.
# In production, manage all secrets via a dedicated secret manager
# (e.g., HashiCorp Vault, AWS Secrets Manager, GCP Secret Manager).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=xcapital
POSTGRES_PASSWORD=xcapital
POSTGRES_DB=xcapital
DATABASE_URL=jdbc:postgresql://localhost:5432/xcapital
DATABASE_USER=xcapital
DATABASE_PASSWORD=xcapital

# ------------------------------------------------------------------------------
# 2. Cache & Message Broker (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Secrets
# ------------------------------------------------------------------------------
# 256-bit secret key used to sign and verify JWT tokens (change in production)
JWT_SECRET=dev_change_me_please_generate_a_secure_256_bit_secret_key

# 128/256-bit AES secret key used for encrypting TOTP MFA seeds
AUTH_MFA_SECRET_KEY=dev_change_me_please_change_mfa_aes_key

# ------------------------------------------------------------------------------
# 4. Service Ports & Internal Routing URLs
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_PORT=8081
PORTFOLIO_PORT=8082
SIMULATION_PORT=8083
AI_PORT=8090
WEB_PORT=4200

# Base URL exposed by the API Gateway
API_BASE_URL=http://localhost:8080

# Internal service URLs (as referenced by API Gateway in Docker Compose)
AUTH_URL=http://auth:8081
PORTFOLIO_URL=http://portfolio:8082
SIMULATION_URL=http://simulation:8083
AI_URL=http://ai:8090

# ------------------------------------------------------------------------------
# 5. Market Data Ingestion & Storage
# ------------------------------------------------------------------------------
MARKETDATA_CSV_DIR=data/market
MARKETDATA_CSV_ENABLED=true

# Optional external market data provider credentials
# MARKETDATA_LICENSE_CATALOG_BEARER_TOKEN=
# MARKETDATA_LICENSE_CATALOG_BASIC_USER=
# MARKETDATA_LICENSE_CATALOG_BASIC_PASSWORD=
# MARKETDATA_LICENSE_CATALOG_SIGNATURE_SECRET=
# MARKETDATA_LICENSE_CATALOG_USER_AGENT=xCAPITAL-MarketData/1.0

# ------------------------------------------------------------------------------
# 6. Notification Providers (Optional)
# ------------------------------------------------------------------------------
# Outbound SMTP Email
NOTIFICATION_SMTP_ENABLED=false
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM_ADDRESS=noreply@xcapital.local
NOTIFICATION_SMTP_FROM_NAME=xCAPITAL
NOTIFICATION_SMTP_STARTTLS=true

# Webhook Notifications
NOTIFICATION_WEBHOOK_ENABLED=true
NOTIFICATION_WEBHOOK_HTTP_ENABLED=false
# NOTIFICATION_WEBHOOK_SIGNATURE_SECRET=

# SMS & Push Notifications (Optional HTTP gateways)
NOTIFICATION_SMS_HTTP_ENABLED=false
# NOTIFICATION_SMS_BASE_URL=
# NOTIFICATION_SMS_API_KEY=

NOTIFICATION_PUSH_HTTP_ENABLED=false
# NOTIFICATION_PUSH_BASE_URL=
# NOTIFICATION_PUSH_API_KEY=

# ------------------------------------------------------------------------------
# 7. Broker & Execution Adapters (Optional)
# ------------------------------------------------------------------------------
BROKER_HTTP_ENABLED=false
# BROKER_HTTP_BASE_URL=
# BROKER_HTTP_API_KEY=
# BROKER_HTTP_SECRET_KEY=

# ------------------------------------------------------------------------------
# 8. Simulation & Backtesting Workers
# ------------------------------------------------------------------------------
SIMULATION_WORKER_MAX_CONCURRENCY=4
SIMULATION_WORKER_POLL_BATCH_SIZE=10
SIMULATION_QUOTA_MAX_PENDING=20
SIMULATION_QUOTA_MAX_RUNNING=2
